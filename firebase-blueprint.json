{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and progression data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "rank": { "type": "string" },
        "preferences": {
          "type": "object",
          "properties": {
            "language": { "type": "string" },
            "narrationVoice": { "type": "string" },
            "offlineDownloads": { "type": "boolean" },
            "accessibilityMode": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Visit": {
      "title": "Monument Visit",
      "description": "A record of a user visiting a monument",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "monumentId": { "type": "string" },
        "monumentName": { "type": "string" },
        "visitedAt": { "type": "string", "format": "date-time" },
        "insightUnlocked": { "type": "string" },
        "xpEarned": { "type": "number" }
      },
      "required": ["userId", "monumentId", "visitedAt"]
    },
    "Artifact": {
      "title": "Digital Artifact",
      "description": "A collectible earned by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "artifactId": { "type": "string" },
        "artifactName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "mintedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "artifactId", "mintedAt"]
    },
    "Story": {
      "title": "Traveler Story",
      "description": "A post shared by a user in the community",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "location": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "users/{userId}/visits/{visitId}": {
      "schema": "Visit",
      "description": "Records of user visits to monuments"
    },
    "users/{userId}/artifacts/{artifactId}": {
      "schema": "Artifact",
      "description": "User's digital collectibles"
    },
    "stories/{storyId}": {
      "schema": "Story",
      "description": "Community shared stories"
    }
  }
}
